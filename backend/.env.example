# Server
PORT=3001
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/backlogvault

# JWT
JWT_SECRET=cambia-esto-por-algo-muy-secreto-en-produccion
JWT_EXPIRES_IN=30d

# RAWG (juegos DB) — gratis en https://rawg.io/apiv2
RAWG_API_KEY=tu_rawg_api_key

# Steam — gratis en https://steamcommunity.com/dev/apikey
STEAM_API_KEY=tu_steam_api_key

# Nintendo Switch Online (NSO)
# No necesitas key — es OAuth público de Nintendo
# Estos son los valores de la app oficial de Nintendo (reverse-engineered)
NSO_CLIENT_ID=71b963c1b7b6d119
NSO_REDIRECT_URI=http://localhost:3001/api/import/nintendo/callback

# Frontend URL (para redirects OAuth)
FRONTEND_URL=http://localhost:5173

# CORS
ALLOWED_ORIGINS=http://localhost:5173

# Encriptación para Nintendo tokens (usa: openssl rand -hex 32)
ENCRYPTION_KEY=genera-una-clave-hex-de-32-bytes-aqui
